{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-olist-devankit"
		},
		"LS_ADLS_Olist_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stolistdl2026.dfs.core.windows.net/"
		},
		"LS_AKV_Olist_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-olist-dev-2026.vault.azure.net/"
		},
		"LS_DBX_Olist_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1014-180556-iwz8gjvf"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-olist-devankit_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Olist_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Olist_properties_typeProperties_url')]"
					},
					"LS_AKV_Olist_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AKV_Olist_properties_typeProperties_baseUrl')]"
					},
					"LS_DBX_Olist_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_DBX_Olist_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}